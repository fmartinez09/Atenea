{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atenea",
  "version": "0.1.0",
  "identifier": "app.atenea.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atenea",
        "width": 1360,
        "height": 850,
        "minWidth": 1060,
        "minHeight": 660,
        "decorations": false,
        "shadow": true,
        "theme": "Light",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OERDNDc4REYwRjhGOUUKUldTZWp3L2ZlTVNOS1laUVA0OU9UQVpmaDBzUHIrOS9YYzZ0SWJvck5iWDJmYWl6L1o1R3U1U2sK",
      "endpoints": [
        "https://github.com/fmartinez09/Atenea/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
